generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String        @id @default(cuid())
  username                  String        @unique
  displayName               String?
  email                     String?       @unique
  emailVerified             Boolean       @default(false)
  emailVerificationCode     String?
  emailVerificationExpires  DateTime?
  password                  String?
  provider                  String?
  providerId                String?
  avatar                    String?
  isAdmin                   Boolean       @default(false)
  favorites                 Favorite[]
  sheets                    CharacterSheet[]
  donations                 Donation[]
  cocktails                 Cocktail[]
  materials                 Material[]
  chatMessages              ChatMessage[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  termsAcceptedAt           DateTime?
  chatReads                 ChatRead[]
  subscription              Subscription?
  avatarFrame               String?  @default("neon")

  @@unique([provider, providerId])
}

model Material {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  fileUrl     String?
  fileSize    Int?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  favorites   Favorite[]
  createdAt   DateTime @default(now())
  isPremium   Boolean  @default(false)

  @@index([authorId])
  @@index([category])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, materialId])
}

model CharacterSheet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Cocktail {
  id        String   @id @default(cuid())
  name      String
  desc      String
  price     Int
  base      Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  donations Donation[]
  createdAt DateTime @default(now())
}

model Donation {
  id         String   @id @default(cuid())
  name       String
  amount     Int
  comment    String?
  cocktailId String
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model ChatGroup {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  order     Int           @default(0)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  reads     ChatRead[]
}

model ChatMessage {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime  @default(now())

  @@index([groupId, createdAt])
}

model ChatRead {
  id            String    @id @default(cuid())
  userId        String
  groupId       String
  lastReadAt    DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
}
model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
model Subscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String   @default("active")    // active | cancelled | expired
  plan          String   @default("demo")      // demo | month | year
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  autoRenew     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
