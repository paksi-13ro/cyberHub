<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Аккаунт — Cyber HUB</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico?v=3">
<link rel="stylesheet" href="style.css">
</head>
<body>

<main>
    <h1 class="page-title">Аккаунт<small>Личный кабинет // Netrunner ID</small></h1>

    <!-- ============ Не авторизован ============ -->
    <section id="auth-section" class="mt-2 hidden">
        <div class="tabs">
            <button class="tab-btn active" data-tab="login">Вход</button>
            <button class="tab-btn" data-tab="register">Регистрация</button>
        </div>

        <!-- Форма входа -->
        <div id="tab-login" class="card accent-cyan tab-content active">
            <h2>Вход</h2>
            <form class="form" id="login-form">
                <label>Логин</label>
                <input type="text" id="login-username" required>
                <label>Пароль</label>
                <input type="password" id="login-password" required>
                <button type="submit" class="btn">Войти</button>
                <p class="msg error" id="login-msg"></p>
                <a href="recover.html" class="text-dim" style="font-size:.85rem">Забыли пароль?</a>
            </form>
            <div class="oauth-divider">или войти через</div>
            <div class="oauth-buttons">
                <a href="#" class="oauth-btn google" data-provider="google"><span class="oauth-icon">G</span> Google</a>
                <a href="#" class="oauth-btn yandex" data-provider="yandex"><span class="oauth-icon">Я</span> Яндекс</a>
                <a href="#" class="oauth-btn vk" data-provider="vk"><span class="oauth-icon">VK</span> ВКонтакте</a>
            </div>
        </div>

        <!-- Форма регистрации -->
        <div id="tab-register" class="card accent-pink tab-content">
            <h2>Регистрация</h2>
            <form class="form" id="register-form">
                <label>Логин (3–20 символов)</label>
                <input type="text" id="reg-username" required minlength="3" maxlength="20">
                <label>Email</label>
                <input type="email" id="reg-email" required>
                <label>Пароль (минимум 6 символов)</label>
                <input type="password" id="reg-password" required minlength="6">
                <label class="checkbox-label">
                    <input type="checkbox" id="reg-agree" required>
                    Я принимаю условия <a href="offer.html" target="_blank">Публичной оферты</a>,
                    <a href="terms.html" target="_blank">Пользовательского соглашения</a> и даю согласие на обработку персональных данных
                </label>
                <button type="submit" class="btn pink">Создать аккаунт</button>
                <p class="msg error" id="reg-msg"></p>
            </form>
            <div class="oauth-divider">или зарегистрироваться через</div>
            <div class="oauth-buttons">
                <a href="#" class="oauth-btn google" data-provider="google"><span class="oauth-icon">G</span> Google</a>
                <a href="#" class="oauth-btn yandex" data-provider="yandex"><span class="oauth-icon">Я</span> Яндекс</a>
                <a href="#" class="oauth-btn vk" data-provider="vk"><span class="oauth-icon">VK</span> ВКонтакте</a>
            </div>
        </div>
    </section>

    <!-- ============ Авторизован ============ -->
    <section id="profile-section" class="mt-2 hidden">
        <div class="grid cols-2">
            <div class="card accent-yellow">
                <h2>Профиль</h2>
                <p id="profile-info" style="line-height:2"></p>
                <button class="btn pink mt-1" id="logout-btn-profile">Выйти из аккаунта</button>
            </div>
            <div class="card accent-cyan">
                <h2>Избранное</h2>
                <div id="favorites-list"><p class="text-dim">Загрузка…</p></div>
            </div>        
        </div>
            
        <div class="card accent-purple mt-2" id="profile-edit-card">
            <h2>Редактирование профиля</h2>

            <div class="grid cols-2">
                <!-- Аватар -->
                <div>
                    <h3>Аватар</h3>
                    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1rem">
                        <img id="avatar-preview" src="" alt="" style="width:80px;height:80px;border-radius:50%;border:3px solid var(--neon-cyan);object-fit:cover;display:none">
                        <div id="avatar-placeholder" style="width:80px;height:80px;border-radius:50%;border:3px solid var(--neon-cyan);background:var(--bg-3);display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:1.4rem;color:var(--neon-cyan)"></div>
                        <div>
                            <input type="file" id="avatar-input" accept="image/*" style="display:none">
                            <button class="btn" id="avatar-upload-btn" type="button">Загрузить</button>
                            <p class="text-dim" style="font-size:0.75rem;margin-top:0.3rem">JPG/PNG/WEBP, до 3 МБ</p>
                        </div>
                    </div>
                </div>

                <!-- Имя и email -->
                <div>
                    <form class="form" id="display-name-form">
                        <h3>Отображаемое имя</h3>
                        <label>Имя (видно другим в чате)</label>
                        <input type="text" id="display-name-input" maxlength="40" placeholder="Например: Джонни Сильверхенд">
                        <button type="submit" class="btn">Сохранить имя</button>
                        <p class="msg" id="display-name-msg"></p>
                    </form>
                </div>
            </div>

            <form class="form mt-2" id="email-form">
                <h3>Смена email</h3>
                <label>Новый email</label>
                <div style="display:flex;gap:.5rem">
                    <input type="email" id="new-email-input" required style="flex:1">
                    <button type="button" class="btn" id="send-code-btn">Получить код</button>
                </div>
                <div id="email-code-wrap" class="hidden">
                    <label>Код из письма</label>
                    <input type="text" id="email-code-input" maxlength="6" placeholder="123456">
                    <button type="submit" class="btn pink">Подтвердить</button>
                </div>
                <p class="msg" id="email-msg"></p>
            </form>
        </div>

        <div class="card accent-cyan mt-2" id="settings-card">
            <h2>Настройки профиля</h2>
            <div class="grid cols-2">
                <form class="form" id="change-login-form">
                    <h3>Сменить логин</h3>
                    <label>Новый логин</label>
                    <input type="text" id="new-login" required minlength="3" maxlength="20">
                    <label>Текущий пароль</label>
                    <input type="password" id="confirm-pass-login" required>
                    <button type="submit" class="btn">Сменить логин</button>
                    <p class="msg" id="login-change-msg"></p>
                </form>

                <form class="form" id="change-password-form">
                    <h3>Сменить пароль</h3>
                    <label>Текущий пароль</label>
                    <input type="password" id="old-pass" required>
                    <label>Новый пароль (мин. 6)</label>
                    <input type="password" id="new-pass" required minlength="6">
                    <label>Повторите новый пароль</label>
                    <input type="password" id="new-pass-2" required minlength="6">
                    <button type="submit" class="btn pink">Сменить пароль</button>
                    <p class="msg" id="pass-change-msg"></p>
                </form>
            </div>
        </div>

        <div class="card accent-pink mt-2">
            <div class="flex-between">
                <h2>Мои листы персонажа</h2>
                <a href="characters.html" class="btn pink" style="font-size:0.75rem;padding:0.35rem 0.8rem">Открыть список</a>
            </div>
            <div id="account-sheets" class="mt-1"><p class="text-dim">Загрузка…</p></div>
        </div>

        <!-- ============ Админ-панель ============ -->
        <div class="card accent-yellow mt-2 hidden" id="admin-panel">
            <h2>🛡️ Админ-панель — пользователи</h2>
            <p class="text-dim mb-1">Управление пользователями системы. Удаление каскадно убирает их избранное и листы персонажей.</p>
            <div id="admin-users-list"><p class="text-dim">Загрузка…</p></div>
        </div>
    </section>
</main>

<script src="app.js"></script>
<script>
// ============================================================
//  Страница аккаунта
// ============================================================

async function initAccountPage() {
    await loadSession();
    renderHeader();
    render();
}

function render() {
    const authSection = document.getElementById('auth-section');
    const profileSection = document.getElementById('profile-section');

    if (!CURRENT_USER) {
        authSection.classList.remove('hidden');
        profileSection.classList.add('hidden');
    } else {
        authSection.classList.add('hidden');
        profileSection.classList.remove('hidden');
        renderProfile();
        if (CURRENT_USER.isAdmin) {
            document.getElementById('admin-panel').classList.remove('hidden');
            renderAdminUsers();
        }
    }
}

async function renderProfile() {
    // Профиль
    const info = document.getElementById('profile-info');
    info.innerHTML = `
        Логин: <b style="color:var(--neon-cyan)">${escapeHtml(CURRENT_USER.username)}</b><br>
        ${CURRENT_USER.email ? `Email: <b style="color:var(--neon-cyan)">${escapeHtml(CURRENT_USER.email)}</b><br>` : ''}
        Роль: <b style="color:var(--neon-pink)">${CURRENT_USER.isAdmin ? 'Администратор' : 'Пользователь'}</b><br>
        Способ входа: <b>${CURRENT_USER.provider ? CURRENT_USER.provider : 'логин/пароль'}</b><br>
        Зарегистрирован: ${formatDate(CURRENT_USER.createdAt || Date.now())}<br>
        Избранных материалов: <b>${(CURRENT_USER._count?.favorites || 0)}</b><br>
        Листов персонажа: <b>${(CURRENT_USER._count?.sheets || 0)}</b>
    `;

    // Скрываем блок смены логина/пароля для OAuth-аккаунтов
    const settingsCard = document.getElementById('settings-card');
    if (CURRENT_USER.provider) {
        settingsCard.style.opacity = '0.5';
        settingsCard.style.pointerEvents = 'none';
        settingsCard.querySelector('h2').innerHTML +=
            ' <span class="text-dim" style="font-size:.8rem">(недоступно для OAuth)</span>';
    }

    // Избранное
    const favWrap = document.getElementById('favorites-list');
    try {
        const favItems = await api.get('/users/me/favorites');
        if (favItems.length === 0) {
            favWrap.innerHTML = '<p class="text-dim">Пока пусто. Добавляй материалы в избранное со страницы «Материалы».</p>';
        } else {
            favWrap.innerHTML = favItems.map(m => `
                <div class="card accent-cyan" style="padding:1rem; margin-bottom:.6rem">
                    <b style="color:var(--neon-cyan)">${escapeHtml(m.title)}</b>
                    <p class="text-dim" style="font-size:.85rem; margin-top:.3rem">${escapeHtml((m.description||'').slice(0,120))}${m.description && m.description.length>120?'…':''}</p>
                    <a href="materials.html" class="btn" style="font-size:.75rem;padding:.35rem .8rem;margin-top:.5rem">Открыть</a>
                </div>
            `).join('');
        }
    } catch (err) {
        favWrap.innerHTML = `<p class="msg error">Ошибка: ${escapeHtml(err.message)}</p>`;
    }

    initProfileEdit();

}

// ============================================================
//  ПРОФИЛЬ: аватар, имя, email
// ============================================================
function initProfileEdit() {
    if (!CURRENT_USER) return;

    // Аватар — предпросмотр
    const preview = document.getElementById('avatar-preview');
    const placeholder = document.getElementById('avatar-placeholder');
    if (CURRENT_USER.avatar) {
        preview.src = CURRENT_USER.avatar;
        preview.style.display = 'block';
        placeholder.style.display = 'none';
    } else {
        placeholder.textContent = (CURRENT_USER.displayName || CURRENT_USER.username)[0].toUpperCase();
    }

    document.getElementById('avatar-upload-btn').addEventListener('click', () => {
        document.getElementById('avatar-input').click();
    });

    document.getElementById('avatar-input').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const fd = new FormData();
        fd.append('avatar', file);
        try {
            const updated = await api.post('/chat/avatar', fd);
            CURRENT_USER.avatar = updated.avatar;
            preview.src = updated.avatar + '?t=' + Date.now();
            preview.style.display = 'block';
            placeholder.style.display = 'none';
            toast('Аватар обновлён', 'success');
        } catch (err) { toast(err.message, 'error'); }
    });

    // Отображаемое имя
    document.getElementById('display-name-input').value = CURRENT_USER.displayName || '';
    document.getElementById('display-name-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const displayName = document.getElementById('display-name-input').value.trim();
        const msg = document.getElementById('display-name-msg');
        try {
            const updated = await api.patch('/users/me/profile', { displayName });
            CURRENT_USER.displayName = updated.displayName;
            msg.classList.add('success'); msg.classList.remove('error');
            msg.textContent = 'Имя сохранено';
            toast('Имя обновлено', 'success');
        } catch (err) {
            msg.classList.add('error'); msg.classList.remove('success');
            msg.textContent = err.message;
        }
    });

    // Email — запрос кода
    let pendingEmail = null;
    document.getElementById('send-code-btn').addEventListener('click', async () => {
        const email = document.getElementById('new-email-input').value.trim();
        const msg = document.getElementById('email-msg');
        if (!email) { msg.textContent = 'Введите email'; return; }
        msg.textContent = 'Отправка кода…';
        msg.classList.remove('error', 'success');
        try {
            await api.post('/users/me/email/request', { email });
            pendingEmail = email;
            document.getElementById('email-code-wrap').classList.remove('hidden');
            msg.classList.add('success');
            msg.textContent = 'Код отправлен на ' + email;
        } catch (err) {
            msg.classList.add('error');
            msg.textContent = err.message;
        }
    });

    // Email — подтверждение
    document.getElementById('email-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = document.getElementById('email-code-input').value.trim();
        const msg = document.getElementById('email-msg');
        if (!code) { msg.textContent = 'Введите код'; return; }
        try {
            await api.post('/users/me/email/verify', { code, email: pendingEmail });
            msg.classList.add('success');
            msg.classList.remove('error');
            msg.textContent = 'Email успешно изменён';
            toast('Email обновлён', 'success');
            setTimeout(() => location.reload(), 800);
        } catch (err) {
            msg.classList.add('error');
            msg.classList.remove('success');
            msg.textContent = err.message;
        }
    });
}

// ============================================================
//  АДМИН-ПАНЕЛЬ: список пользователей
// ============================================================
async function renderAdminUsers() {
    const wrap = document.getElementById('admin-users-list');
    try {
        const users = await api.get('/admin/users');
        wrap.innerHTML = `
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Логин</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Вход</th>
                        <th>Регистрация</th>
                        <th>Активность</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    ${users.map(u => `
                        <tr>
                            <td><b style="color:var(--neon-cyan)">${escapeHtml(u.username)}</b></td>
                            <td class="text-dim">${escapeHtml(u.email || '—')}</td>
                            <td>${u.isAdmin ? '<span class="tag" style="border-color:var(--neon-yellow);color:var(--neon-yellow)">admin</span>' : '<span class="tag">user</span>'}</td>
                            <td class="text-dim">${escapeHtml(u.provider || 'локально')}</td>
                            <td class="text-dim">${formatDate(u.createdAt)}</td>
                            <td class="text-dim" style="font-size:.8rem">
                                ★${u._count.favorites} / 🧬${u._count.sheets} / 🍸${u._count.donations}
                            </td>
                            <td>
                                ${u.id === CURRENT_USER.id
                                    ? '<span class="text-dim" style="font-size:.8rem">это ты</span>'
                                    : `
                                        <button class="btn mini toggle-admin-btn" data-id="${u.id}" data-admin="${u.isAdmin}">
                                            ${u.isAdmin ? 'Снять админа' : 'Назначить админом'}
                                        </button>
                                        <button class="btn mini pink delete-user-btn" data-id="${u.id}" data-name="${escapeHtml(u.username)}">
                                            Удалить
                                        </button>
                                    `}
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        `;

        // Обработчики кнопок
        wrap.querySelectorAll('.toggle-admin-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const isAdmin = btn.dataset.admin === 'true';
                if (!confirm(`${isAdmin ? 'Снять' : 'Назначить'} администратора?`)) return;
                try {
                    await api.patch(`/admin/users/${btn.dataset.id}/role`, { isAdmin: !isAdmin });
                    toast('Роль обновлена', 'success');
                    renderAdminUsers();
                } catch (err) {
                    toast(err.message, 'error');
                }
            });
        });

        wrap.querySelectorAll('.delete-user-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm(`Удалить пользователя «${btn.dataset.name}»? Это действие необратимо.`)) return;
                try {
                    await api.delete(`/admin/users/${btn.dataset.id}`);
                    toast('Пользователь удалён', 'success');
                    renderAdminUsers();
                } catch (err) {
                    toast(err.message, 'error');
                }
            });
        });
    } catch (err) {
        wrap.innerHTML = `<p class="msg error">Ошибка загрузки: ${escapeHtml(err.message)}</p>`;
    }
}

// ============================================================
//  Обработчики форм
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
    initAccountPage();

    // Переключение табов Вход/Регистрация
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
        });
    });

    // ---------- Согласие с офертой для OAuth ----------
    function showTermsModal(provider) {
        const overlay = document.createElement('div');
        overlay.className = 'modal-overlay';
        overlay.innerHTML = `
            <div class="modal" style="max-width: 520px">
                <button class="modal-close" aria-label="Закрыть">×</button>
                <h2>Перед входом</h2>
                <p style="margin-bottom:1rem; color:var(--text-dim)">
                    Продолжая, вы принимаете условия
                    <a href="offer.html" target="_blank">Публичной оферты</a> и
                    <a href="terms.html" target="_blank">Пользовательского соглашения</a>,
                    а также даёте согласие на обработку персональных данных.
                </p>
                <label class="checkbox-label" style="margin-bottom:1rem">
                    <input type="checkbox" id="oauth-agree">
                    Я согласен с условиями
                </label>
                <button class="btn pink" id="oauth-continue" disabled style="width:100%">
                    Продолжить через ${provider === 'google' ? 'Google' : provider === 'yandex' ? 'Яндекс' : 'ВКонтакте'}
                </button>
            </div>
        `;
        document.body.appendChild(overlay);

        const close = () => overlay.remove();
        overlay.querySelector('.modal-close').addEventListener('click', close);
        overlay.addEventListener('click', e => { if (e.target === overlay) close(); });

        const checkbox = overlay.querySelector('#oauth-agree');
        const btn = overlay.querySelector('#oauth-continue');

        checkbox.addEventListener('change', () => {
            btn.disabled = !checkbox.checked;
        });

        btn.addEventListener('click', () => {
            window.location.href = `/api/auth/${provider}`;
        });
    }

    // Навешиваем на все кнопки OAuth
    document.querySelectorAll('.oauth-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const provider = btn.dataset.provider;
            if (provider) showTermsModal(provider);
        });
    });

    // Вход
    document.getElementById('login-form').addEventListener('submit', async e => {
        e.preventDefault();
        const u = document.getElementById('login-username').value.trim();
        const p = document.getElementById('login-password').value;
        const msg = document.getElementById('login-msg');
        msg.textContent = '';
        msg.classList.remove('success');
        try {
            await login(u, p);
            toast('Вход выполнен', 'success');
            setTimeout(() => location.reload(), 400);
        } catch (err) {
            msg.classList.add('error');
            msg.textContent = err.message;
        }
    });

    // Регистрация
    document.getElementById('register-form').addEventListener('submit', async e => {
        e.preventDefault();
        const u = document.getElementById('reg-username').value.trim();
        const email = document.getElementById('reg-email').value.trim();
        const p = document.getElementById('reg-password').value;
        const agree = document.getElementById('reg-agree').checked;
        const msg = document.getElementById('reg-msg');
        msg.textContent = '';
        msg.classList.remove('success', 'error');

        if (!agree) {
            msg.classList.add('error');
            msg.textContent = 'Нужно принять оферту и соглашение.';
            return;
        }

        try {
            await register(u, p, email, agree);
            toast('Аккаунт создан', 'success');
            setTimeout(() => location.reload(), 500);
        } catch (err) {
            msg.classList.add('error');
            msg.textContent = err.message;
        }
    });

    // Выход из профиля
    document.getElementById('logout-btn-profile').addEventListener('click', async () => {
        await logout();
        toast('Вы вышли', 'info');
        setTimeout(() => location.reload(), 400);
    });

    // Смена логина
    document.getElementById('change-login-form').addEventListener('submit', async e => {
        e.preventDefault();
        const newLogin = document.getElementById('new-login').value.trim();
        const password = document.getElementById('confirm-pass-login').value;
        const msg = document.getElementById('login-change-msg');
        msg.textContent = '';
        msg.classList.remove('success');
        try {
            await api.patch('/users/me/username', { newUsername: newLogin, password });
            toast('Логин обновлён', 'success');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            msg.classList.add('error');
            msg.textContent = err.message;
        }
    });

    // Смена пароля
    document.getElementById('change-password-form').addEventListener('submit', async e => {
        e.preventDefault();
        const oldPassword = document.getElementById('old-pass').value;
        const newPassword = document.getElementById('new-pass').value;
        const newPassword2 = document.getElementById('new-pass-2').value;
        const msg = document.getElementById('pass-change-msg');
        msg.textContent = '';
        msg.classList.remove('success');

        if (newPassword !== newPassword2) {
            msg.classList.add('error');
            msg.textContent = 'Новые пароли не совпадают.';
            return;
        }
        try {
            await api.patch('/users/me/password', { oldPassword, newPassword });
            msg.classList.add('success');
            msg.textContent = 'Пароль изменён.';
            toast('Пароль обновлён', 'success');
            e.target.reset();
        } catch (err) {
            msg.classList.add('error');
            msg.textContent = err.message;
        }
    });
});
</script>
</body>
</html>
